# =====================================================================
# CareBridge AI - Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in this directory.
# 2. Add your private Google Gemini API key below.
# 3. DO NOT commit `.env` to GitHub. Keep your actual key private!
# =====================================================================

# Google Gemini Vision API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Host & Port (defaults to 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000
